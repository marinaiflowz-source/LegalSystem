## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Build results
bin/
obj/
out/

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

# Visual Studio Code
.vscode/
.vscode/*

# Rider
.idea/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# DotCover
*.dotCover

# Microsoft Azure Web Apps
.azure-pipelines/
*.publishsettings

# User-specific files
*.vspscc
*.vssscc
*.tmp
*.log
*.sln.ide
*.sln.iml

# Windows image file caches
Thumbs.db
ehthumbs.db

# Others
*.dbmdl
*.bak
*.sql
*.orig

# NuGet
*.nupkg
# The packages folder can be ignored because of PackageReference
**/packages/*
!**/packages/build/
!**/packages/repositories.config

# Dotnet CLI
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Core
#wwwroot/
node_modules/
bower_components/
dist/
build/

# Logs
*.log

# Environment files
.env
.env.*

# Resharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# Coverlet coverage
coverage*.json
coverage*.xml
coverage*.info

# JetBrains Rider
.idea/
*.sln.iml

# Local secrets
secrets.json

# Docker
**/Dockerfile.*
docker-compose.*
*.dockerignore

# Static analysis
.stylecop
SonarQube/

# Test results
TestResults/
*.trx
*.coverage
*.coveragexml
*.v2
*.json
*.bin
*.config
*.vsidx
*.pubxml
/CRM.API/appsettings.Development.json
/CRM.API/appsettings.json
